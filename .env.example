# ---------- Browser build (VITE_* is compiled into the public app — never put secrets here) ----------
# Leave the Supabase pair empty for a local-only build (no cloud, connect-src 'none').
# The anon key is public by design; access is enforced by RLS (supabase/migrations).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Sign-in buttons to show (each must be enabled in Supabase → Authentication → Providers). Email links always work.
VITE_AUTH_PROVIDERS=google,apple
# Google Cloud OAuth client ID (public). Enables "Save to Google Drive": no database needed for this.
VITE_GOOGLE_CLIENT_ID=
# Stripe Payment Links (Dashboard → Payment Links). After-payment redirect: https://<site>/app/#upgraded
VITE_CHECKOUT_URL_YEARLY=
VITE_CHECKOUT_URL_LIFETIME=
# Stripe customer portal login link (Settings → Billing → Customer portal)
VITE_BILLING_PORTAL_URL=

# ---------- Both: public site address, no trailing slash ----------
SITE_URL=https://your-domain.com

# ---------- Server only (Vercel → Settings → Environment Variables; never prefix with VITE_) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Random 32+ char strings, e.g. `openssl rand -hex 32`
CRON_SECRET=
CHECKIN_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Zero-Trust Vault <legacy@your-domain.com>"
